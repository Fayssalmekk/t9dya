{
  "appId": "com.t9dya.app",
  "appName": "T9DYA",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#f8fafc",
    "allowMixedContent": false,
    "useLegacyBridge": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#f8fafcff",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "native"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK",
      "hidden": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "backgroundColor": "#0f172a",
      "style": "DARK"
    }
  }
}
