VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public production origin used only by the installed Android app for /api calls.
# Example: https://your-project.vercel.app (no trailing slash)
VITE_API_BASE_URL=

# Server only: never prefix these values with VITE_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_VISION_MODEL=gpt-5.4-nano
OPENAI_TEXT_MODEL=gpt-5.4-nano

# Optional server-only cost/quality controls. Defaults preserve image quality.
# See docs/AI_COSTS.md before lowering image quality, size or vision detail.
# OPENAI_ENHANCE_QUALITY=medium
# OPENAI_COMBINE_QUALITY=medium
# OPENAI_COMPOSE_QUALITY=medium
# OPENAI_ENHANCE_SIZE=1024x1536
# OPENAI_COMBINE_SIZE=1024x1024
# OPENAI_COMPOSE_SIZE=1024x1536
# OPENAI_ENHANCE_COMPRESSION=85
# OPENAI_COMBINE_COMPRESSION=80
# OPENAI_COMPOSE_COMPRESSION=90
# OPENAI_TAG_DETAIL=low
# OPENAI_MEAL_DETAIL=low
# gpt-5.4-nano: none (already its default). Other models: omit unless supported.
# Use 'default' to omit reasoning entirely; only set an effort your model supports.
# OPENAI_VISION_REASONING_EFFORT=none
# OPENAI_TEXT_REASONING_EFFORT=none
# First attempt ceilings; one retry at 2x only after token-limit truncation.
# OPENAI_TAG_MAX_OUTPUT_TOKENS=300
# OPENAI_MEAL_MAX_OUTPUT_TOKENS=450
# OPENAI_SUGGEST_MAX_OUTPUT_TOKENS=900
# OPENAI_CAR_MAX_OUTPUT_TOKENS=1400
# OPENAI_CAR_RESEARCH_MAX_OUTPUT_TOKENS=2400
# OPENAI_CAR_HORIZON_KM=15000
# OPENAI_CAR_WEB_MODEL=gpt-5.4-nano
# OPENAI_CAR_REASONING_EFFORT=low
# OPENAI_SUGGEST_MAX_ITEMS=120
# OPENAI_SUGGEST_MAX_BYTES=16000
# 0 disables tag cache + in-flight dedupe. Cache scoped to authenticated UID.
# OPENAI_TAG_CACHE_TTL_SECONDS=300

ALLOWED_UIDS=uid_fayssal,uid_salma
FIREBASE_API_KEY=
# Exact deployed web origin allowed by /api/ai, without a trailing slash.
# Example: https://your-project.vercel.app
APP_ORIGIN=
