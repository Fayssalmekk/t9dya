rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validMembers(members) {
      return members is list
        && members.size() >= 1
        && members.size() <= 2
        && members.toSet().size() == members.size();
    }

    function isMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function sharesHousehold(userId) {
      let viewer = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let owner = get(/databases/$(database)/documents/users/$(userId)).data;
      return signedIn()
        && viewer.householdId is string
        && viewer.householdId == owner.householdId
        && request.auth.uid in get(/databases/$(database)/documents/households/$(viewer.householdId)).data.members
        && userId in get(/databases/$(database)/documents/households/$(viewer.householdId)).data.members;
    }

    function validClothing() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 250000
        && request.resource.data.colors is list
        && request.resource.data.colors.size() <= 12
        && request.resource.data.season is list
        && request.resource.data.season.size() <= 4
        && request.resource.data.style is list
        && request.resource.data.style.size() <= 12
        && request.resource.data.wearCount is number
        && request.resource.data.wearCount >= 0
        && request.resource.data.status in ['clean', 'dirty', 'laundry']
        && request.resource.data.favorite is bool;
    }

    match /users/{userId} {
      allow create: if false;
      allow read, update: if owns(userId);
      allow delete: if false;

      match /clothes/{itemId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId) && validClothing();
      }

      match /clothesImages/{itemId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.image is string
          && request.resource.data.image.size() < 900000;
      }

      match /outfits/{outfitId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 30;
      }

      match /outfitPlans/{dateId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.outfitId is string
          && request.resource.data.outfitId.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /healthReadings/{readingId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && request.resource.data.value < 700
          && request.resource.data.unit in ['mg/dL', 'mmol/L'];
      }

      match /insulinDoses/{doseId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.insulin in ['novorapid', 'tresiba']
          && request.resource.data.units is number
          && request.resource.data.units > 0
          && request.resource.data.units <= 200;
      }

      match /healthMedications/{medicationId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
      }

      match /medicationChecks/{checkId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /healthAppointments/{appointmentId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.doctor is string
          && request.resource.data.doctor.size() > 0
          && request.resource.data.doctor.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /mealAnalyses/{mealId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.carbs is number
          && request.resource.data.carbs >= 0
          && request.resource.data.carbs <= 1000
          && request.resource.data.thumb is string
          && request.resource.data.thumb.size() < 300000;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('householdId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == null
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == '')
        && validMembers(request.resource.data.members)
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberProfiles.keys().size() == 1
        && request.resource.data.memberProfiles[request.auth.uid].uid == request.auth.uid;
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members)
        ||
        (!(request.auth.uid in resource.data.members)
          && validMembers(resource.data.members)
          && resource.data.members.size() == 1
          && validMembers(request.resource.data.members)
          && request.resource.data.members.size() == 2
          && request.resource.data.members.toSet().hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberProfiles.keys().size() == 2
          && request.resource.data.memberProfiles.keys().hasAll(resource.data.memberProfiles.keys())
          && request.resource.data.memberProfiles[request.auth.uid].uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberProfiles', 'updatedAt']))
      );
      allow delete: if false;

      match /{collectionName}/{documentId} {
        allow read, write: if collectionName in ['items', 'lists', 'customProducts', 'charges', 'chargePayments', 'envelopes', 'envelopeTransactions', 'purchases', 'priceHistory', 'templates', 'pantry', 'trips'] && isMember(householdId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
