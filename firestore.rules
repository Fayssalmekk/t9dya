rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validMembers(members) {
      return members is list
        && members.size() >= 1
        && members.size() <= 2
        && members.toSet().size() == members.size();
    }

    function isMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    function sharesHousehold(userId) {
      let viewer = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let owner = get(/databases/$(database)/documents/users/$(userId)).data;
      return signedIn()
        && viewer.householdId is string
        && viewer.householdId == owner.householdId
        && request.auth.uid in get(/databases/$(database)/documents/households/$(viewer.householdId)).data.members
        && userId in get(/databases/$(database)/documents/households/$(viewer.householdId)).data.members;
    }

    function validUserProfileUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let regularProfileUpdate = changed.hasOnly(['displayName', 'birthDate', 'sex', 'diabetic', 'updatedAt']);
      let firstHouseholdSetup = (!('householdId' in resource.data)
          || resource.data.householdId == null
          || resource.data.householdId == '')
        && changed.hasOnly(['uid', 'displayName', 'email', 'birthDate', 'sex', 'diabetic', 'householdId', 'updatedAt']);
      return request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.birthDate is string
        && request.resource.data.birthDate.size() <= 10
        && request.resource.data.sex in ['', 'male', 'female']
        && request.resource.data.diabetic is bool
        && (regularProfileUpdate || firstHouseholdSetup);
    }

    function validHouseholdMemberUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.members == resource.data.members
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.memberProfiles.keys() == resource.data.memberProfiles.keys()
        && request.resource.data.memberProfiles.diff(resource.data.memberProfiles).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.memberProfiles[request.auth.uid].uid == request.auth.uid
        && changed.hasOnly(['name', 'memberProfiles', 'budget', 'lastUsedStore', 'activeListId', 'updatedAt']);
    }

    function validClothing() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 50
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 250000
        && request.resource.data.colors is list
        && request.resource.data.colors.size() <= 12
        && request.resource.data.season is list
        && request.resource.data.season.size() <= 4
        && request.resource.data.style is list
        && request.resource.data.style.size() <= 12
        && request.resource.data.wearCount is number
        && request.resource.data.wearCount >= 0
        && request.resource.data.status in ['clean', 'dirty', 'laundry']
        && request.resource.data.favorite is bool;
    }

    function validCarKm(value) {
      return value is int && value >= 0 && value <= 2000000;
    }

    function validCarDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function validVehicle() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'year', 'transmission', 'color', 'plate', 'engine', 'insuranceDate', 'inspectionDate', 'assistancePhone', 'odometer', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'mileageUpdatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.year is int && data.year >= 1900 && data.year <= 2100
        && data.transmission is string && data.transmission.size() <= 40
        && data.color is string && data.color.size() <= 100
        && data.plate is string && data.plate.size() <= 30
        && data.engine is string && data.engine.size() <= 100
        && data.assistancePhone is string && data.assistancePhone.size() <= 40
        && validCarDate(data.insuranceDate) && validCarDate(data.inspectionDate)
        && (data.odometer == null || validCarKm(data.odometer))
        && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
    }

    function validCarTask() {
      let data = request.resource.data;
      return data.keys().hasOnly(['vehicleId', 'name', 'intervalKm', 'intervalMonths', 'baselineKm', 'baselineDate', 'note', 'active', 'createdBy', 'createdAt', 'updatedAt'])
        && data.vehicleId == 'main'
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.intervalKm is int && data.intervalKm >= 0 && data.intervalKm <= 200000
        && data.intervalMonths is int && data.intervalMonths >= 0 && data.intervalMonths <= 120
        && (data.intervalKm > 0 || data.intervalMonths > 0)
        && validCarKm(data.baselineKm) && validCarDate(data.baselineDate)
        && (data.intervalMonths == 0 || data.baselineDate != '')
        && data.note is string && data.note.size() <= 300
        && data.active is bool && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow create: if false;
      allow read: if owns(userId);
      allow update: if owns(userId) && validUserProfileUpdate(userId);
      allow delete: if false;

      match /clothes/{itemId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId) && validClothing();
      }

      match /clothesImages/{itemId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.image is string
          && request.resource.data.image.size() < 900000;
      }

      match /outfits/{outfitId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 30
          && (!('generationNotes' in request.resource.data)
            || (request.resource.data.generationNotes is string
              && request.resource.data.generationNotes.size() <= 600));
      }

      match /outfitImages/{outfitId} {
        allow read: if owns(userId) || sharesHousehold(userId);
        allow delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.image is string
          && request.resource.data.image.size() < 900000;
      }

      match /outfitPlans/{dateId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId)
          && request.resource.data.outfitId is string
          && request.resource.data.outfitId.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /healthReadings/{readingId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.value is number
          && request.resource.data.value > 0
          && request.resource.data.value < 700
          && request.resource.data.unit in ['mg/dL', 'mmol/L'];
      }

      match /insulinDoses/{doseId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.insulin in ['novorapid', 'tresiba']
          && request.resource.data.units is number
          && request.resource.data.units > 0
          && request.resource.data.units <= 200;
      }

      match /healthMedications/{medicationId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0;
      }

      match /medicationChecks/{checkId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /healthAppointments/{appointmentId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.doctor is string
          && request.resource.data.doctor.size() > 0
          && request.resource.data.doctor.size() <= 100
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10;
      }

      match /mealAnalyses/{mealId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.carbs is number
          && request.resource.data.carbs >= 0
          && request.resource.data.carbs <= 1000
          && request.resource.data.thumb is string
          && request.resource.data.thumb.size() < 300000;
      }

      match /healthWater/{dateId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.date == dateId
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && request.resource.data.amountMl is number
          && request.resource.data.amountMl >= 0
          && request.resource.data.amountMl <= 2000
          && request.resource.data.goalMl == 2000;
      }

      match /healthBadHabits/{habitId} {
        allow read, delete: if owns(userId) || sharesHousehold(userId);
        allow create, update: if (owns(userId) || sharesHousehold(userId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.category in ['soda', 'sugar', 'smoking', 'screen', 'sleep', 'other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.lastOccurredOn is string
          && request.resource.data.lastOccurredOn.size() == 10
          && request.resource.data.goalDays is number
          && request.resource.data.goalDays >= 1
          && request.resource.data.goalDays <= 365
          && request.resource.data.relapseCount is number
          && request.resource.data.relapseCount >= 0
          && request.resource.data.bestStreakDays is number
          && request.resource.data.bestStreakDays >= 0;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /households/{householdId} {
      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (!('householdId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == null
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == '')
        && validMembers(request.resource.data.members)
        && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberProfiles.keys().size() == 1
        && request.resource.data.memberProfiles[request.auth.uid].uid == request.auth.uid;
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members && validHouseholdMemberUpdate())
        ||
        (!(request.auth.uid in resource.data.members)
          && validMembers(resource.data.members)
          && resource.data.members.size() == 1
          && validMembers(request.resource.data.members)
          && request.resource.data.members.size() == 2
          && request.resource.data.members.toSet().hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.memberProfiles.keys().size() == 2
          && request.resource.data.memberProfiles.keys().hasAll(resource.data.memberProfiles.keys())
          && request.resource.data.memberProfiles[request.auth.uid].uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberProfiles', 'updatedAt']))
      );
      allow delete: if false;

      match /locations/{userId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid', 'latitude', 'longitude', 'accuracy', 'heading', 'speed', 'sharing', 'updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.latitude is number
          && request.resource.data.latitude >= -90
          && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number
          && request.resource.data.longitude >= -180
          && request.resource.data.longitude <= 180
          && request.resource.data.accuracy is number
          && request.resource.data.accuracy >= 0
          && request.resource.data.sharing == true
          && request.resource.data.updatedAt == request.time;
        allow delete: if isMember(householdId) && request.auth.uid == userId;
      }

      match /vehicles/{vehicleId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && vehicleId == 'main' && validVehicle()
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if isMember(householdId) && vehicleId == 'main' && validVehicle()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /vehicleMileage/{entryId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.keys().hasOnly(['vehicleId', 'previous', 'value', 'mode', 'note', 'createdBy', 'createdAt'])
          && request.resource.data.vehicleId == 'main'
          && validCarKm(request.resource.data.value)
          && (request.resource.data.previous == null || validCarKm(request.resource.data.previous))
          && request.resource.data.previous == get(/databases/$(database)/documents/households/$(householdId)/vehicles/main).data.odometer
          && request.resource.data.value == getAfter(/databases/$(database)/documents/households/$(householdId)/vehicles/main).data.odometer
          && request.resource.data.mode in ['absolute', 'increment', 'correction']
          && request.resource.data.note is string && request.resource.data.note.size() <= 240
          && (request.resource.data.mode != 'correction' || request.resource.data.note.size() > 0)
          && (request.resource.data.mode == 'correction' || request.resource.data.previous == null || request.resource.data.value >= request.resource.data.previous)
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /vehicleTasks/{taskId} {
        allow read: if isMember(householdId);
        allow create: if isMember(householdId) && validCarTask()
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if isMember(householdId) && validCarTask()
          && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /vehicleServices/{serviceId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.keys().hasOnly(['vehicleId', 'taskId', 'taskName', 'odometer', 'performedOn', 'garage', 'note', 'createdBy', 'createdAt'])
          && request.resource.data.vehicleId == 'main'
          && request.resource.data.taskId is string && request.resource.data.taskId.size() > 0 && request.resource.data.taskId.size() <= 100
          && request.resource.data.taskName is string && request.resource.data.taskName.size() > 0 && request.resource.data.taskName.size() <= 100
          && get(/databases/$(database)/documents/households/$(householdId)/vehicleTasks/$(request.resource.data.taskId)).data.active == true
          && validCarKm(request.resource.data.odometer)
          && request.resource.data.odometer <= get(/databases/$(database)/documents/households/$(householdId)/vehicles/main).data.odometer
          && validCarDate(request.resource.data.performedOn) && request.resource.data.performedOn != ''
          && request.resource.data.garage is string && request.resource.data.garage.size() <= 100
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update: if false;
      }

      match /{collectionName}/{documentId} {
        allow read, write: if collectionName in ['items', 'lists', 'customProducts', 'customRecipes', 'charges', 'chargePayments', 'envelopes', 'envelopeTransactions', 'expenses', 'salaryMonths', 'purchases', 'priceHistory', 'templates', 'pantry', 'trips'] && isMember(householdId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
